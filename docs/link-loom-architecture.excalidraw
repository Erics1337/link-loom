{"version":2,"appState":{"scrollX":-223.40495079705917,"hoveredElementIds":{},"selectedLinearElement":null,"snapLines":[],"currentItemStartArrowhead":null,"currentItemFontFamily":5,"selectedElementsAreBeingDragged":false,"frameRendering":{"outline":true,"enabled":true,"clip":true,"name":true},"penMode":false,"selectedGroupIds":{},"toast":null,"croppingElementId":null,"boxSelectionMode":"contain","currentItemFontSize":20,"contextMenu":null,"showHyperlinkPopup":false,"gridSize":20,"penDetected":false,"previousSelectedElementIds":{"text_4cam4arp":true},"stats":{"open":false,"panels":3},"newElement":null,"currentItemBackgroundColor":"transparent","cursorButton":"up","exportScale":2,"activeLockedId":null,"offsetTop":0,"editingTextElement":{"seed":1144,"strokeStyle":"solid","id":"text_4cam4arp","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":15,"opacity":100,"verticalAlign":"top","updated":1780418011713,"locked":false,"text":"Key architectural read\n\nLink Loom is deliberately split between a stateful browser-side actuator and a server-side AI\/data pipeline. Supabase is the system of record for proposed structure, progress, auth-linked ownership, billing gates, and backups. The extension owns Chrome-native state and applies changes only after presenting a preview. The queue abstraction lets the same worker code run inline locally, deterministically in tests, and through SQS\/Lambda in production. The most important correctness mechanism is job_generation: it prevents old delayed\/retried jobs from corrupting the latest run.","version":77,"autoResize":true,"type":"text","backgroundColor":"transparent","index":"b1e","roundness":null,"containerId":null,"baseline":51.25,"originalText":"Key architectural read\n\nLink Loom is deliberately split between a stateful browser-side actuator and a server-side AI\/data pipeline. Supabase is the system of record for proposed structure, progress, auth-linked ownership, billing gates, and backups. The extension owns Chrome-native state and applies changes only after presenting a preview. The queue abstraction lets the same worker code run inline locally, deterministically in tests, and through SQS\/Lambda in production. The most important correctness mechanism is job_generation: it prevents old delayed\/retried jobs from corrupting the latest run.","height":56.25,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":661588177,"textAlign":"left","fontFamily":1,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":54.107291180930133,"angle":0,"y":1623.8902703831395,"width":4280.978515625},"name":"Untitled-2026-06-01-2338","frameToHighlight":null,"followedBy":{},"isResizing":false,"currentItemStrokeStyle":"solid","currentItemRoundness":"round","defaultSidebarDockedPreference":false,"shouldCacheIgnoreZoom":false,"currentItemFillStyle":"solid","objectsSnapModeEnabled":false,"offsetLeft":0,"viewModeEnabled":false,"width":1512,"isLoading":false,"activeTool":{"locked":false,"fromSelection":false,"lastActiveTool":null,"type":"selection","customType":null},"gridStep":5,"fileHandle":null,"zoom":{"value":1.6019490000000001},"currentItemRoughness":1,"isMidpointSnappingEnabled":true,"selectedElementIds":{},"searchMatches":null,"openPopup":null,"exportBackground":true,"activeEmbeddable":null,"showWelcomeScreen":true,"currentItemStrokeColor":"#1e1e1e","openDialog":null,"editingFrame":null,"selectionElement":null,"gridModeEnabled":false,"startBoundElement":null,"viewBackgroundColor":"#ffffff","errorMessage":null,"elementsToHighlight":null,"isRotating":false,"bindMode":"orbit","exportWithDarkMode":false,"currentItemEndArrowhead":"arrow","exportEmbedScene":false,"scrollY":-1250.5658964894426,"bindingPreference":"enabled","multiElement":null,"currentItemStrokeWidth":2,"currentHoveredFontFamily":null,"currentItemTextAlign":"left","userToFollow":null,"currentItemArrowType":"sharp","currentItemOpacity":100,"suggestedBinding":null,"scrolledOutside":false,"preferredSelectionTool":{"type":"selection","initialized":true},"resizingElement":null,"zenModeEnabled":false,"lockedMultiSelections":{},"collaborators":{},"editingGroupId":null,"lastPointerDownWith":"mouse","isCropping":false,"originSnapOffset":null,"openSidebar":null,"height":1078,"openMenu":null,"isBindingEnabled":true,"theme":"light"},"files":{},"source":"https:\/\/excalidraw.com","elements":[{"isDeleted":false,"locked":false,"strokeColor":"#4f46e5","link":null,"roughness":1,"groupIds":[],"index":"b0U","backgroundColor":"#eef2ff","angle":0,"fillStyle":"solid","strokeWidth":2,"version":2,"roundness":{"type":3},"type":"rectangle","updated":1780417272353,"id":"rectangle_gay942hs","x":40,"seed":1000,"boundElements":[],"y":30,"opacity":100,"height":80,"width":1740,"frameId":null,"strokeStyle":"solid","versionNonce":121740721},{"seed":1002,"strokeStyle":"solid","id":"text_sfsrj09n","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":22,"opacity":100,"verticalAlign":"top","updated":1780417272353,"locked":false,"text":"Link Loom Architecture - current repo map (extension-driven bookmark organization)","version":3,"autoResize":true,"type":"text","backgroundColor":"transparent","index":"b0V","roundness":null,"containerId":null,"baseline":22.5,"originalText":"Link Loom Architecture - current repo map (extension-driven bookmark organization)","height":27.5,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":1031082463,"textAlign":"left","fontFamily":1,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":54,"angle":0,"y":44,"width":1712},{"seed":1004,"strokeStyle":"solid","id":"text_56mt4ox4","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":14,"opacity":100,"verticalAlign":"top","updated":1780417272353,"locked":false,"text":"Read left-to-right: Chrome extension scans and later mutates bookmarks; backend stores and enriches data; queue workers produce a cluster tree; web app owns account, dashboard, and billing surfaces.","version":4,"autoResize":true,"type":"text","backgroundColor":"transparent","index":"b0W","roundness":null,"containerId":null,"baseline":14,"originalText":"Read left-to-right: Chrome extension scans and later mutates bookmarks; backend stores and enriches data; queue workers produce a cluster tree; web app owns account, dashboard, and billing surfaces.","height":17.5,"link":null,"strokeColor":"#334155","fillStyle":"solid","groupIds":[],"versionNonce":1300545425,"textAlign":"left","fontFamily":1,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":58,"angle":0,"y":82,"width":1670},{"isDeleted":false,"locked":false,"strokeColor":"#0f766e","link":null,"roughness":1,"groupIds":[],"index":"b0X","backgroundColor":"#f0fdfa","angle":0,"fillStyle":"solid","strokeWidth":2,"version":110,"roundness":{"type":3},"type":"rectangle","updated":1780417613672,"id":"rectangle_mk188g53","x":45.490503248612413,"seed":1006,"boundElements":[],"y":142.71412306552975,"opacity":100,"height":820,"width":360,"frameId":null,"strokeStyle":"solid","versionNonce":1824098577},{"seed":1008,"strokeStyle":"solid","id":"text_u81jhjoe","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":16,"opacity":100,"verticalAlign":"top","updated":1780417563228,"locked":false,"text":"Chrome Extension \/ Browser Boundary\n\nReact popup: App + screens\nuseBookmarkWeaver orchestrates session state\n\nChrome APIs:\n- bookmarks.getTree() scan\n- bookmarks.create\/move\/update\/remove\n- storage.local for local session artifacts\n\nImportant local state:\n- preOrganizeBackup\n- bookmarkStructureVersions (max 20)\n- overflow bookmarks for free-tier slice\n- root\/preferred-root maps\n\nThe extension performs the browser \nwrite phase. Backend returns a plan-like \nstructure; it does not mutate Chrome.","version":9,"autoResize":true,"type":"text","backgroundColor":"transparent","index":"b0Y","roundness":null,"containerId":null,"baseline":335,"originalText":"Chrome Extension \/ Browser Boundary\n\nReact popup: App + screens\nuseBookmarkWeaver orchestrates session state\n\nChrome APIs:\n- bookmarks.getTree() scan\n- bookmarks.create\/move\/update\/remove\n- storage.local for local session artifacts\n\nImportant local state:\n- preOrganizeBackup\n- bookmarkStructureVersions (max 20)\n- overflow bookmarks for free-tier slice\n- root\/preferred-root maps\n\nThe extension performs the browser \nwrite phase. Backend returns a plan-like \nstructure; it does not mutate Chrome.","height":380,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":772950719,"textAlign":"left","fontFamily":1,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":54,"angle":0,"y":164,"width":375.10394287109375},{"isDeleted":false,"locked":false,"strokeColor":"#2563eb","link":null,"roughness":1,"groupIds":[],"index":"b0Z","backgroundColor":"#eff6ff","angle":0,"fillStyle":"solid","strokeWidth":2,"version":7,"roundness":{"type":3},"type":"rectangle","updated":1780417272353,"id":"rectangle_k1jp3l9l","x":460,"seed":1010,"boundElements":[],"y":150,"opacity":100,"height":820,"width":330,"frameId":null,"strokeStyle":"solid","versionNonce":596862495},{"seed":1012,"strokeStyle":"solid","id":"text_otsr9twf","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":16,"opacity":100,"verticalAlign":"top","updated":1780417650106,"locked":false,"text":"Fastify Backend API\n\nRoutes:\nPOST \/ingest\nGET \/status\/:userId\nGET \/structure\/:userId\nPOST \/cancel\/:userId\nPOST \/trigger-clustering\/:userId\nPOST \/bookmarks\/add\nPOST \/dead-links\/check (Pro)\nPOST \/auto-rename\/:userId (Pro)\n\/backups CRUD + restore\n\/register-device\n\/search\n\nAuth gate:\nrequireRequestUserId() verifies Supabase \nbearer token; fallback user ids only in \ntests\/dev flags.\n\nService-role Supabase client writes DB \nstate.","version":12,"autoResize":true,"type":"text","backgroundColor":"transparent","index":"b0a","roundness":null,"containerId":null,"baseline":375,"originalText":"Fastify Backend API\n\nRoutes:\nPOST \/ingest\nGET \/status\/:userId\nGET \/structure\/:userId\nPOST \/cancel\/:userId\nPOST \/trigger-clustering\/:userId\nPOST \/bookmarks\/add\nPOST \/dead-links\/check (Pro)\nPOST \/auto-rename\/:userId (Pro)\n\/backups CRUD + restore\n\/register-device\n\/search\n\nAuth gate:\nrequireRequestUserId() verifies Supabase \nbearer token; fallback user ids only in \ntests\/dev flags.\n\nService-role Supabase client writes DB \nstate.","height":440,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":907631903,"textAlign":"left","fontFamily":1,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":474,"angle":0,"y":164,"width":330.39999389648438},{"isDeleted":false,"locked":false,"strokeColor":"#ea580c","link":null,"roughness":1,"groupIds":[],"index":"b0b","backgroundColor":"#fff7ed","angle":0,"fillStyle":"solid","strokeWidth":2,"version":9,"roundness":{"type":3},"type":"rectangle","updated":1780417272353,"id":"rectangle_rncebhbh","x":850,"seed":1014,"boundElements":[],"y":150,"opacity":100,"height":820,"width":430,"frameId":null,"strokeStyle":"solid","versionNonce":966740543},{"seed":1016,"strokeStyle":"solid","id":"text_glmlyz58","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":16,"opacity":100,"verticalAlign":"top","updated":1780417272353,"locked":false,"text":"Queue + Worker Pipeline\n\nQueue driver abstraction:\n- inline: local dev microtasks\/timeouts\n- test: drainable in-memory queue\n- sqs: production SQS messages\n\nIngest worker\n1. hash URL -> content_hash\n2. upsert shared_links\n3. upsert bookmarks pending\n4. cache hit -> embedded\n5. cache miss -> enqueue enrichment\n6. delayed clustering job\n\nEnrichment worker\nfetch URL via safeFetch(5s), Cheerio title\/meta, status=enriched, enqueue embedding.\n\nEmbedding worker\nrecheck shared cache, OpenAI text-embedding-3-small on miss, persist vector, status=embedded.\n\nClustering worker\ndefers while pending\/enriched exist; pages 1000 rows; parses vectors; normalizes; recursive ml-kmeans; density profile controls target leaf size\/max children; rebalances tiny groups; names folders by heuristic or GPT-4o-mini; writes clusters + assignments.","version":10,"autoResize":true,"type":"text","backgroundColor":"transparent","index":"b0c","roundness":null,"containerId":null,"baseline":455,"originalText":"Queue + Worker Pipeline\n\nQueue driver abstraction:\n- inline: local dev microtasks\/timeouts\n- test: drainable in-memory queue\n- sqs: production SQS messages\n\nIngest worker\n1. hash URL -> content_hash\n2. upsert shared_links\n3. upsert bookmarks pending\n4. cache hit -> embedded\n5. cache miss -> enqueue enrichment\n6. delayed clustering job\n\nEnrichment worker\nfetch URL via safeFetch(5s), Cheerio title\/meta, status=enriched, enqueue embedding.\n\nEmbedding worker\nrecheck shared cache, OpenAI text-embedding-3-small on miss, persist vector, status=embedded.\n\nClustering worker\ndefers while pending\/enriched exist; pages 1000 rows; parses vectors; normalizes; recursive ml-kmeans; density profile controls target leaf size\/max children; rebalances tiny groups; names folders by heuristic or GPT-4o-mini; writes clusters + assignments.","height":460,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":713080113,"textAlign":"left","fontFamily":1,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":864,"angle":0,"y":164,"width":402},{"isDeleted":false,"locked":false,"strokeColor":"#64748b","link":null,"roughness":1,"groupIds":[],"index":"b0d","backgroundColor":"#f8fafc","angle":0,"fillStyle":"solid","strokeWidth":2,"version":11,"roundness":{"type":3},"type":"rectangle","updated":1780417272353,"id":"rectangle_t2dzfkrh","x":1330,"seed":1018,"boundElements":[],"y":150,"opacity":100,"height":820,"width":460,"frameId":null,"strokeStyle":"solid","versionNonce":1222224479},{"seed":1020,"strokeStyle":"solid","id":"text_bvkxlchq","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":16,"opacity":100,"verticalAlign":"top","updated":1780417272353,"locked":false,"text":"Supabase Postgres + Auth\n\nAuth\n- web and extension use Supabase sessions\n- backend validates bearer token with auth.getUser()\n\nCore tables\nusers: billing flags + Stripe ids\nshared_links: URL hash cache + vector(1536)\nbookmarks: per-user chrome_id\/url\/title\/ai_title\/status\/content_hash\nclusters: generated folder tree parent_id\ncluster_assignments: bookmark -> cluster\nuser_devices: app-level 3 device cap\n\nOperational tables\nuser_pipeline_controls: is_cancelled + job_generation\nqueue_job_failures: exhausted Lambda retries\nstructure_snapshots \/ snapshot_clusters \/ snapshot_assignments: DB-side backups\n\nRPCs\nbegin_user_pipeline_run(): increments generation and clears cancel\nmark_user_cancelled()\ncreate_structure_snapshot()\nrestore_structure_snapshot()","version":13,"autoResize":true,"type":"text","backgroundColor":"transparent","index":"b0e","roundness":null,"containerId":null,"baseline":475,"originalText":"Supabase Postgres + Auth\n\nAuth\n- web and extension use Supabase sessions\n- backend validates bearer token with auth.getUser()\n\nCore tables\nusers: billing flags + Stripe ids\nshared_links: URL hash cache + vector(1536)\nbookmarks: per-user chrome_id\/url\/title\/ai_title\/status\/content_hash\nclusters: generated folder tree parent_id\ncluster_assignments: bookmark -> cluster\nuser_devices: app-level 3 device cap\n\nOperational tables\nuser_pipeline_controls: is_cancelled + job_generation\nqueue_job_failures: exhausted Lambda retries\nstructure_snapshots \/ snapshot_clusters \/ snapshot_assignments: DB-side backups\n\nRPCs\nbegin_user_pipeline_run(): increments generation and clears cancel\nmark_user_cancelled()\ncreate_structure_snapshot()\nrestore_structure_snapshot()","height":480,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":179564305,"textAlign":"left","fontFamily":1,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":1344,"angle":0,"y":164,"width":432},{"isDeleted":false,"locked":false,"strokeColor":"#0891b2","link":null,"roughness":1,"groupIds":[],"index":"b0f","backgroundColor":"#ecfeff","angle":0,"fillStyle":"solid","strokeWidth":2,"version":14,"roundness":{"type":3},"type":"rectangle","updated":1780417272353,"id":"rectangle_qzku0h5u","x":80,"seed":1022,"boundElements":[],"y":1030,"opacity":100,"height":290,"width":300,"frameId":null,"strokeStyle":"solid","versionNonce":504563327},{"seed":1024,"strokeStyle":"solid","id":"text_5n8d0u6r","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":14,"opacity":100,"verticalAlign":"top","updated":1780417761509,"locked":false,"text":"Extension happy path\n\n1. ensure account or anonymous session\n2. chrome.bookmarks.getTree()\n3. collectScannedBookmarks()\n4. local backup before processing\n5. POST \/ingest with clustering settings\n6. poll \/status every 2s\n7. fetch \/structure\n8. buildStructurePreview() restores Chrome \nroot context and includes overflow bookmarks\n9. user applies changes\n10. save cloud backup when logged in, then \ncreate folders, move\/update bookmarks, \nclean old root children if apply was clean","version":19,"autoResize":true,"type":"text","backgroundColor":"transparent","index":"b0g","roundness":null,"containerId":null,"baseline":205,"originalText":"Extension happy path\n\n1. ensure account or anonymous session\n2. chrome.bookmarks.getTree()\n3. collectScannedBookmarks()\n4. local backup before processing\n5. POST \/ingest with clustering settings\n6. poll \/status every 2s\n7. fetch \/structure\n8. buildStructurePreview() restores Chrome \nroot context and includes overflow bookmarks\n9. user applies changes\n10. save cloud backup when logged in, then \ncreate folders, move\/update bookmarks, \nclean old root children if apply was clean","height":262.5,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":1945760319,"textAlign":"left","fontFamily":1,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":94,"angle":0,"y":1044,"width":316.28802490234375},{"isDeleted":false,"locked":false,"strokeColor":"#4f46e5","link":null,"roughness":1,"groupIds":[],"index":"b0h","backgroundColor":"#eef2ff","angle":0,"fillStyle":"solid","strokeWidth":2,"version":16,"roundness":{"type":3},"type":"rectangle","updated":1780417272353,"id":"rectangle_29hmmdze","x":460,"seed":1026,"boundElements":[],"y":1030,"opacity":100,"height":290,"width":330,"frameId":null,"strokeStyle":"solid","versionNonce":403431071},{"seed":1028,"strokeStyle":"solid","id":"text_ewrnh1ki","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":12.009089049107493,"opacity":100,"verticalAlign":"top","updated":1780417803033,"locked":false,"text":"Status\/progress model\n\n\/status derives progress from DB counts \nrather than mutable queue progress:\n- pendingRaw\n- enriched\n- embedded\n- errored\n- clusters\n- assigned\n- remainingToAssign\n- isIngesting\n- isClusteringActive\n- isDone\n- isPremium\n\nExtension maps these into UX stages: indexing, \nenrichment\/embedding, structuring.","version":100,"autoResize":true,"type":"text","backgroundColor":"transparent","index":"b0i","roundness":null,"containerId":null,"baseline":275,"originalText":"Status\/progress model\n\n\/status derives progress from DB counts \nrather than mutable queue progress:\n- pendingRaw\n- enriched\n- embedded\n- errored\n- clusters\n- assigned\n- remainingToAssign\n- isIngesting\n- isClusteringActive\n- isDone\n- isPremium\n\nExtension maps these into UX stages: indexing, \nenrichment\/embedding, structuring.","height":270.20450360491844,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":1013387103,"textAlign":"left","fontFamily":1,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":474,"angle":0,"y":1044,"width":283.65470323499892},{"isDeleted":false,"locked":false,"strokeColor":"#ca8a04","link":null,"roughness":1,"groupIds":[],"index":"b0j","backgroundColor":"#fefce8","angle":0,"fillStyle":"solid","strokeWidth":2,"version":18,"roundness":{"type":3},"type":"rectangle","updated":1780417272353,"id":"rectangle_pg7qthu6","x":850,"seed":1030,"boundElements":[],"y":1030,"opacity":100,"height":290,"width":430,"frameId":null,"strokeStyle":"solid","versionNonce":1769255615},{"seed":1032,"strokeStyle":"solid","id":"text_1sex4cf7","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":14,"opacity":100,"verticalAlign":"top","updated":1780417879007,"locked":false,"text":"Resilience \/ correctness controls\n\nCancellation and stale job protection:\n- new ingest\/manual cluster calls begin_user_pipeline_run()\n- every queued job carries jobGeneration\n- isUserCancelled() treats older generation as cancelled\n- \/cancel marks cancelled and resets pending\/enriched to idle\n\nClustering recovery:\n- if no pending\/enriched remain but clusters are missing\/partial, \nextension can trigger clustering once\n- clustering can recover stale pending\/enriched rows by marking \ncache hits embedded or re-queueing enrichment\/embedding\n\nLambda retry exhaustion records queue_job_failures and \nmarks scoped bookmark(s) error.","version":26,"autoResize":true,"type":"text","backgroundColor":"transparent","index":"b0k","roundness":null,"containerId":null,"baseline":222.5,"originalText":"Resilience \/ correctness controls\n\nCancellation and stale job protection:\n- new ingest\/manual cluster calls begin_user_pipeline_run()\n- every queued job carries jobGeneration\n- isUserCancelled() treats older generation as cancelled\n- \/cancel marks cancelled and resets pending\/enriched to idle\n\nClustering recovery:\n- if no pending\/enriched remain but clusters are missing\/partial, \nextension can trigger clustering once\n- clustering can recover stale pending\/enriched rows by marking \ncache hits embedded or re-queueing enrichment\/embedding\n\nLambda retry exhaustion records queue_job_failures and \nmarks scoped bookmark(s) error.","height":280,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":268178623,"textAlign":"left","fontFamily":1,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":863.91190477383725,"angle":0,"y":1044,"width":435.73599243164062},{"isDeleted":false,"locked":false,"strokeColor":"#db2777","link":null,"roughness":1,"groupIds":[],"index":"b0l","backgroundColor":"#fdf2f8","angle":0,"fillStyle":"solid","strokeWidth":2,"version":20,"roundness":{"type":3},"type":"rectangle","updated":1780417272353,"id":"rectangle_ge1in38n","x":1330,"seed":1034,"boundElements":[],"y":1030,"opacity":100,"height":290,"width":460,"frameId":null,"strokeStyle":"solid","versionNonce":451805919},{"seed":1036,"strokeStyle":"solid","id":"text_3ef60s8p","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":12.065037299127221,"opacity":100,"verticalAlign":"top","updated":1780417938791,"locked":false,"text":"Web app \/ account \/ billing\n\nNext.js app owns marketing, login, dashboard, links, devices, \nbackups, billing.\n\nStripe flow:\n\/api\/checkout or \/api\/create-checkout-session creates \nCheckout for current Supabase user.\n\/api\/webhooks\/stripe verifies signature and updates \nusers.is_premium plus subscription status\/customer ids.\n\nPremium unlocks:\n- import size above free tier\n- dead-link scanning\n- auto-renaming\n\nBackend still enforces limits server-side via FREE_TIER_LIMIT \nand users.is_premium.","version":104,"autoResize":true,"type":"text","backgroundColor":"transparent","index":"b0m","roundness":null,"containerId":null,"baseline":240,"originalText":"Web app \/ account \/ billing\n\nNext.js app owns marketing, login, dashboard, links, devices, \nbackups, billing.\n\nStripe flow:\n\/api\/checkout or \/api\/create-checkout-session creates \nCheckout for current Supabase user.\n\/api\/webhooks\/stripe verifies signature and updates \nusers.is_premium plus subscription status\/customer ids.\n\nPremium unlocks:\n- import size above free tier\n- dead-link scanning\n- auto-renaming\n\nBackend still enforces limits server-side via FREE_TIER_LIMIT \nand users.is_premium.","height":271.46333923036264,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":48355313,"textAlign":"left","fontFamily":1,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":1344,"angle":0,"y":1044,"width":388.04783210259336},{"isDeleted":false,"locked":false,"strokeColor":"#9333ea","link":null,"roughness":1,"groupIds":[],"index":"b0n","backgroundColor":"#faf5ff","angle":0,"fillStyle":"solid","strokeWidth":2,"version":22,"roundness":{"type":3},"type":"rectangle","updated":1780417272353,"id":"rectangle_ypu51jtp","x":40,"seed":1038,"boundElements":[],"y":1370,"opacity":100,"height":190,"width":360,"frameId":null,"strokeStyle":"solid","versionNonce":1292390143},{"seed":1040,"strokeStyle":"solid","id":"text_dgy2lje1","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":14,"opacity":100,"verticalAlign":"top","updated":1780417272353,"locked":false,"text":"External services\n\nOpenAI\n- embeddings: text-embedding-3-small\n- folder naming: gpt-4o-mini with concurrency + 429 retry\/backoff\n- bookmark rename suggestions for Pro auto-rename\n\nRemote websites\n- enrichment fetches title\/meta\n- dead-link scanner probes URLs with deadline\/concurrency controls","version":23,"autoResize":true,"type":"text","backgroundColor":"transparent","index":"b0o","roundness":null,"containerId":null,"baseline":170,"originalText":"External services\n\nOpenAI\n- embeddings: text-embedding-3-small\n- folder naming: gpt-4o-mini with concurrency + 429 retry\/backoff\n- bookmark rename suggestions for Pro auto-rename\n\nRemote websites\n- enrichment fetches title\/meta\n- dead-link scanner probes URLs with deadline\/concurrency controls","height":175,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":564618353,"textAlign":"left","fontFamily":1,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":54,"angle":0,"y":1384,"width