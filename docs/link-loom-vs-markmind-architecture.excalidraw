    },
    {
      "id": "boundary-text",
      "type": "text",
      "x": 90,
      "y": 955,
      "width": 980,
      "height": 130,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1054,
      "version": 1,
      "versionNonce": 1054,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Link Loom centralizes intelligence and persistence: better for scale, snapshots, search, billing, and recovery, with more operational surface.\n\nMarkMind keeps the system in the browser: simpler and easier to trust, with direct provider choice, but no server-side memory, shared embedding cache, account state, or durable backend recovery.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Link Loom centralizes intelligence and persistence: better for scale, snapshots, search, billing, and recovery, with more operational surface.\n\nMarkMind keeps the system in the browser: simpler and easier to trust, with direct provider choice, but no server-side memory, shared embedding cache, account state, or durable backend recovery.",
      "lineHeight": 1.25
    }
  ],
