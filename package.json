{
  "name": "link-loom-monorepo",
  "private": true,
  "scripts": {
    "build": "./node_modules/.bin/turbo run build",
    "dev": "./node_modules/.bin/turbo run dev",
    "lint": "./node_modules/.bin/turbo run lint",
    "test:e2e": "./node_modules/.bin/turbo run test:e2e",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset --local",
    "test:supabase": "supabase test db",
    "test:e2e:local-supabase": "BACKEND_E2E_USE_LOCAL_SUPABASE=true BACKEND_E2E_ENABLE_TEST_ENDPOINTS=true QUEUE_DRIVER=test pnpm --filter @link-loom/backend-e2e test:e2e",
    "smoke:backend": "pnpm --filter backend smoke",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "turbo": "latest",
    "prettier": "^3.0.0"
  },
  "packageManager": "pnpm@8.10.0",
  "pnpm": {
    "overrides": {
      "@crxjs/vite-plugin>cheerio": "1.0.0"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
